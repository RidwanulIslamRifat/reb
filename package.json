{
  "name": "@rifat/reb",
  "version": "0.1.0",
  "description": "Evidence-backed analysis of SaaS products, driven by your AI agent.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "reb": "dist/cli.js"
  },
  "files": [
    "dist",
    "handbook",
    "pipelines",
    "reports"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build --config src/dashboard/app/vite.config.ts --logLevel warn",
    "test": "vitest run",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/dashboard/app"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "commander": "^15.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cytoscape": "^3.34.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "marked": "^18.1.1",
    "playwright-core": "^1.64.0",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
