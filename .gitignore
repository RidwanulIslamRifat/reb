# Dependencies and build output
node_modules/
dist/
coverage/

# Secrets
.env
.env.*

# reb run folders and captured traffic: may hold personal data and secrets
runs/
tmp-runs/
*.har
# Synthetic HAR fixtures (fake secrets only) are the one exception
!tests/fixtures/har/*.har
!tests/fixtures/run-sample/evidence/inbox/*/*.har

# Editors and OS
.DS_Store
.vscode/
.idea/

# Logs written when the owner runs reb against a fixture run (ROADMAP "How the owner checks it")
tests/fixtures/*/logs/
tests/fixtures/*/kb/graph.json
tests/fixtures/*/kb/stats.json
tests/fixtures/*/**/.*.lock
# Written when the owner imports or plans against the sample run without --dry-run
tests/fixtures/run-sample/evidence/ledger.jsonl
tests/fixtures/run-sample/evidence/imports/
tests/fixtures/run-sample/evidence/rea/
tests/fixtures/run-sample/notes/
# The dashboard sample run keeps its logs: they are part of what the dashboard shows
!tests/fixtures/dashboard-sample/logs/
