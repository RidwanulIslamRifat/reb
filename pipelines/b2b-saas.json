{
  "id": "b2b-saas",
  "title": "B2B SaaS",
  "description": "Software sold to businesses by subscription: modules, seat or usage pricing tiers, admin and team features, integrations, buyer and user personas.",
  "focus": {
    "after": ["features"],
    "before": ["curate"]
  },
  "tasks": [
    {
      "id": "company",
      "title": "Map the company, product and modules from the home page, docs and about page",
      "role": "desk_researcher",
      "depends_on": [],
      "inputs": ["brief.md"],
      "outputs": ["kb/nodes/", "evidence/ledger.jsonl"],
      "done_when": [
        "at least 1 company node",
        "at least 1 product node",
        "at least 2 module nodes",
        "every product node has evidence"
      ]
    },
    {
      "id": "pricing",
      "title": "Find the pricing tiers and what each includes (seats, limits, add-ons)",
      "role": "desk_researcher",
      "depends_on": ["company"],
      "inputs": ["brief.md"],
      "outputs": ["kb/nodes/", "evidence/ledger.jsonl"],
      "done_when": ["at least 1 pricing_tier node", "every pricing_tier node has evidence"]
    },
    {
      "id": "features",
      "title": "List the features with evidence and link them to modules and tiers",
      "role": "feature_analyst",
      "depends_on": ["company", "pricing"],
      "inputs": ["brief.md"],
      "outputs": ["kb/nodes/", "evidence/ledger.jsonl"],
      "done_when": [
        "at least 5 feature nodes",
        "every feature node has evidence",
        "every feature node has a gated_by link"
      ]
    },
    {
      "id": "integrations",
      "title": "Find the integrations from the integrations page and docs",
      "role": "desk_researcher",
      "depends_on": ["features"],
      "inputs": ["brief.md"],
      "outputs": ["kb/nodes/", "evidence/ledger.jsonl"],
      "done_when": ["at least 1 integration node", "every integration node has evidence"]
    },
    {
      "id": "market",
      "title": "Find competitors and the market segments they sell to",
      "role": "market_researcher",
      "depends_on": ["company"],
      "inputs": ["brief.md"],
      "outputs": ["kb/nodes/", "evidence/ledger.jsonl"],
      "done_when": [
        "at least 3 competitor nodes",
        "at least 1 market_segment node",
        "every competitor node has evidence"
      ],
      "reports": ["market", "business"]
    },
    {
      "id": "tech",
      "title": "Detect the tech stack from public pages",
      "role": "tech_observer",
      "depends_on": ["company"],
      "inputs": ["brief.md"],
      "outputs": ["evidence/ledger.jsonl", "notes/tech_observer-stack.md"],
      "done_when": ["at least 1 evidence record", "file notes/tech_observer-stack.md exists"],
      "reports": ["build"]
    },
    {
      "id": "walkthrough",
      "title": "Prepare a checklist for the user's own session (admin setup, inviting a teammate, a core workflow)",
      "role": "walkthrough_coach",
      "depends_on": ["features"],
      "inputs": ["brief.md"],
      "outputs": ["evidence/inbox/", "evidence/ledger.jsonl"],
      "done_when": [
        "the user finished their own session in the product",
        "what they saw is recorded as observed evidence"
      ]
    },
    {
      "id": "personas",
      "title": "Describe buyer and user personas and their journeys",
      "role": "business_analyst",
      "depends_on": ["features"],
      "inputs": ["brief.md"],
      "outputs": ["kb/nodes/", "evidence/ledger.jsonl"],
      "done_when": [
        "at least 2 persona nodes",
        "at least 2 journey nodes",
        "every journey node has a uses link",
        "every persona node has a does link"
      ],
      "reports": ["business", "feature"]
    },
    {
      "id": "business-model",
      "title": "Describe the business model: who pays, pricing logic, sales motion",
      "role": "business_analyst",
      "depends_on": ["pricing", "personas"],
      "inputs": ["brief.md"],
      "outputs": ["notes/business_analyst-model.md"],
      "done_when": [
        "file notes/business_analyst-model.md exists",
        "the draft cites node ids or E-/S- ids for every claim"
      ],
      "reports": ["business"]
    },
    {
      "id": "architecture",
      "title": "Describe data objects, integrations and how it is likely built",
      "role": "architect",
      "depends_on": ["features", "integrations", "tech"],
      "inputs": ["brief.md"],
      "outputs": ["kb/nodes/", "notes/architect-build.md"],
      "done_when": [
        "at least 3 data_object nodes",
        "every data_object node has evidence",
        "file notes/architect-build.md exists"
      ],
      "reports": ["build"]
    },
    {
      "id": "curate",
      "title": "Clean the knowledge graph until validate_graph is clean",
      "role": "kb_curator",
      "depends_on": [
        "company",
        "pricing",
        "features",
        "integrations",
        "market",
        "tech",
        "walkthrough",
        "personas",
        "business-model",
        "architecture"
      ],
      "inputs": ["kb/nodes/", "evidence/ledger.jsonl"],
      "outputs": ["kb/nodes/", "kb/graph.json", "kb/stats.json"],
      "done_when": ["validate_graph is clean", "no two nodes hold the same fact"]
    },
    {
      "id": "audit",
      "title": "Audit the graph against the brief and the requested reports (run_audit)",
      "role": "auditor",
      "depends_on": ["curate"],
      "inputs": ["brief.md", "kb/nodes/", "notes/"],
      "outputs": ["logs/audits/"],
      "done_when": ["the latest audit is acted on"]
    },
    {
      "id": "report",
      "title": "Write the {report} report",
      "role": "report_writer",
      "depends_on": ["audit"],
      "inputs": ["kb/nodes/", "notes/", "logs/audits/"],
      "outputs": ["reports/{report}.md"],
      "done_when": [
        "file reports/{report}.md exists",
        "every claim cites node ids or E-/S- ids",
        "the report ends with sources and open questions"
      ],
      "per_report": true
    }
  ]
}
